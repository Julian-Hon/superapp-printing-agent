# TechHub SuperApp API URL
# Do not include a trailing slash.
API_BASE_URL=https://your-superapp.example.com

# Must match PICKLIST_PRINT_AGENT_TOKEN on the SuperApp backend.
# Replace this with a long, randomly generated secret in the real .env file.
AGENT_TOKEN=replace-with-a-secure-random-token

# Exact Windows printer name as shown in Settings or Control Panel.
PRINTER_NAME=Your Printer Name

# Seconds between print-queue checks when no WebSocket event is received.
POLL_SECONDS=15

# Seconds to wait before retrying after an error.
ERROR_RETRY_SECONDS=5

# Intended maximum print duration in seconds.
PRINT_TIMEOUT_SECONDS=120

# Directory used for PDFs awaiting printing.
SPOOL_DIR=C:\TechHubPrintAgent\jobs

# PDF rendering resolution. Higher values improve quality but use more memory.
NATIVE_RENDER_DPI=600

# Valid values: actual or fit
NATIVE_PRINT_SCALE_MODE=actual
